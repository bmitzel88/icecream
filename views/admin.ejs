<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/head', {title: "Admin"}) %>

  <!-- Must come first -->
  <script src="https://code.jquery.com/jquery-3.7.1.js"></script>

  <!-- Add data table information -->
  <script src="https://cdn.datatables.net/3.1.4/js/dataTables.min.js"></script>
  <link rel="stylesheet" href="https://cdn.datatables.net/3.1.4/css/dataTables.dataTables.min.css">
</head>

<body>
  <main>
    <h1>View Orders</h1>

    <table id="order-table" class="display">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Flavor</th>
          <th>Cone</th>
          <th>Toppings</th>
          <th>Comment</th>
          <th>Date and Time</th>
        </tr>
      </thead>

      <tbody>
        <% orders.forEach(order => { %>
        <tr>
          <td><%= order.customer %></td>
          <td><%= order.email %></td>
          <td><%= order.flavor %></td>
          <td><%= order.cone %></td>
          <td><%= order.toppings %></td>
          <td><%= order.comment %></td>
          <td><%= order.timestamp.toLocaleString() %></td>
        </tr>
        <% }); %>

      </tbody>

    </table>

    <a class="button" href="/logout">Logout</a>
  </main>

  <script>
    new DataTable('#order-table');
  </script>
</body>

</html>